# The DuckDB release version
DUCKDB_VERSION=v2.0.0

# Official extensions mirrored from extensions.duckdb.org
CORE_EXTENSIONS=httpfs iceberg avro sqlite_scanner

# The wasm-bindgen CLI that turns the browser application of webui into a loadable module.
# It must equal the wasm-bindgen crate version pinned in extensions/webui/app/Cargo.toml.
WASM_BINDGEN_VERSION=0.2.130

# Container images
BUILD_IMAGE=almalinux:8
RUST_IMAGE=rust:1.95.0-slim-bookworm
PYTHON_IMAGE=python:3.12-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.26
