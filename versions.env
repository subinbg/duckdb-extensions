# Single source of truth for versions. Read by the Makefile (include) and by the
# Dockerfile (sourced with sh), so keep plain KEY=VALUE lines and quote lists.

# DuckDB release the bundle targets. The Python client must be exactly this version.
# Bump together with duckdb-neo in Cargo.toml (0.20000.x targets v2.0.0), then run
# `make lock` and `make cargo-lock`.
DUCKDB_VERSION=v2.0.0

# Official extensions mirrored from extensions.duckdb.org.
# avro is required by iceberg; the sqlite extension's file name is sqlite_scanner.
CORE_EXTENSIONS="httpfs iceberg avro sqlite_scanner"

# Toolchains used inside the containers.
RUST_VERSION=1.95.0
UV_VERSION=0.11.26
